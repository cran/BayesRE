Package: BayesRE
Type: Package
Title: Bayesian Multiple Linear Regression Estimation for Crop Yield
Version: 0.1.0
Authors@R: c(person("Prakash","Kumar",role=c("aut","cre"),email="prakash289111@gmail.com"),
             person(c("Himadri","Sekhar"),"Roy",role="aut"),
